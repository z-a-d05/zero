{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "api_gateway/main.py",
      "buildCommand": "pip install -r requirements.txt",
      "devCommand": "uvicorn api_gateway.main:app --host 127.0.0.1 --port 8000",
      "bindings": [
        { "type": "service", "service": "prediction-service", "format": "url", "env": "PREDICTION_SERVICE_URL" },
        { "type": "service", "service": "explainability-service", "format": "url", "env": "EXPLAINABILITY_SERVICE_URL" }
      ]
    },
    "prediction-service": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "prediction_service/main.py",
      "buildCommand": "pip install -r requirements.txt",
      "devCommand": "uvicorn prediction_service.main:app --host 127.0.0.1 --port 8001"
    },
    "explainability-service": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "explainability_service/main.py",
      "buildCommand": "pip install -r requirements.txt",
      "devCommand": "uvicorn explainability_service.main:app --host 127.0.0.1 --port 8002"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "devCommand": "npm run dev",
      "outputDirectory": "dist",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "VITE_API_URL" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
