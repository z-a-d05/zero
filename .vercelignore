# Vercel ignore file - exclude files from deployment to reduce bundle size

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
.next/
out/
coverage/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python cache
.pytest_cache/
.mypy_cache/
.tox/
.venv/
venv/
.env/

# Git
.git/
.gitignore

# Documentation and config (not needed in production bundle)
docs/
*.md
*.txt
docker-compose.yml
Dockerfile*
run_dpis.*
deployment/

# ML models (large files - not needed for serverless functions)
ml_pipelines/models/
*.pkl
*.joblib
*.onnx
*.h5

# Test files
tests/

# Backend source structure - only keep what's needed for each service
# We'll use functions config to split services appropriately
