# ============================================================
# DPIS — Environment Variables Example
# Copy this file to .env and fill in real values before running
# ============================================================

# ------ Database ------
DATABASE_URL=postgresql+asyncpg://dpis_user:CHANGE_ME@postgres:5432/dpis_db
POSTGRES_USER=dpis_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dpis_db

# ------ Security ------
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------ Internal Service URLs (used inside Docker network) ------
PREDICTION_SERVICE_URL=http://prediction_service:8001
EXPLAINABILITY_SERVICE_URL=http://explainability_service:8002
PATIENT_SERVICE_URL=http://patient_service:8003
AUDIT_SERVICE_URL=http://audit_service:8004

# ------ Frontend (Vite build-time) ------
VITE_API_URL=http://localhost:8000
