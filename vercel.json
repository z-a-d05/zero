{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/api_gateway",
      "framework": "fastapi",
      "entrypoint": "main.py",
      "buildCommand": "pip install -r ../../requirements.txt",
      "devCommand": "uvicorn main:app --host 127.0.0.1 --port 8000",
      "bindings": [
        { "type": "service", "service": "prediction-service", "format": "url", "env": "PREDICTION_SERVICE_URL" },
        { "type": "service", "service": "explainability-service", "format": "url", "env": "EXPLAINABILITY_SERVICE_URL" }
      ]
    },
    "prediction-service": {
      "root": "backend/prediction_service",
      "framework": "fastapi",
      "entrypoint": "main.py",
      "buildCommand": "pip install -r ../../requirements.txt",
      "devCommand": "uvicorn main:app --host 127.0.0.1 --port 8001"
    },
    "explainability-service": {
      "root": "backend/explainability_service",
      "framework": "fastapi",
      "entrypoint": "main.py",
      "buildCommand": "pip install -r ../../requirements.txt",
      "devCommand": "uvicorn main:app --host 127.0.0.1 --port 8002"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && node node_modules/vite/bin/vite.js build",
      "devCommand": "npm run dev",
      "outputDirectory": "dist",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "VITE_API_URL" }
      ]
    }
  },
  "functions": {
    "backend/api_gateway/main.py": {
      "maxDuration": 10,
      "memory": 512
    },
    "backend/api_gateway/routers/predictions.py": {
      "maxDuration": 15,
      "memory": 1024
    },
    "backend/api_gateway/routers/patients.py": {
      "maxDuration": 10,
      "memory": 512
    },
    "backend/api_gateway/routers/auth.py": {
      "maxDuration": 10,
      "memory": 512
    },
    "backend/prediction_service/main.py": {
      "maxDuration": 15,
      "memory": 1024
    },
    "backend/explainability_service/main.py": {
      "maxDuration": 10,
      "memory": 512
    },
    "frontend/dist/**": {
      "maxDuration": 10,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
